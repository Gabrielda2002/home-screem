---
interface ImageMetadata {
  src: string;
  width: number;
  height: number;
  format: string;
}

interface Props {
  title: string;
  icon: string | ImageMetadata;
  bgColor: string;
  url: string;
}

const { title, icon, bgColor, url } = Astro.props;

const isImageObject = typeof icon === "object" && icon !== null && "src" in icon;
const iconSrc = isImageObject ? icon.src : icon;
const isImageIcon =
  isImageObject ||
  /^(https?:\/\/|\/|\.\.?\/)/.test(iconSrc) ||
  /\.(png|jpe?g|gif|svg|webp|ico)(\?.*)?$/i.test(iconSrc);
---

<div
  class={`p-2 rounded-xl text-card-foreground shadow-md hover:shadow-xl hover:scale-95 transition-all duration-300 h-auto ${bgColor}`}
>
  <a href={url} class="flex flex-col items-center" target="_blank">
    {
      isImageIcon ? (
        <img
          src={iconSrc}
          alt={title}
          class="w-8 h-8 object-contain"
          loading="lazy"
        />
      ) : (
        <span class="text-xl">{iconSrc}</span>
      )
    }
    <span class="relative text-white text-sm font-semibol">{title}</span>
  </a>
</div>
